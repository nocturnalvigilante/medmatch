# Copy to .env.local and fill in. Never commit real keys.
GEMINI_API_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# optional, raises openFDA rate limit
OPENFDA_API_KEY=
# optional overrides (defaults: gemini-3.5-flash-lite for reading/advice, gemini-3.5-flash for photos)
GEMINI_MODEL=
GEMINI_VISION_MODEL=
# optional, defaults to https://medmatch-xi.vercel.app (used for sitemap and share links)
NEXT_PUBLIC_SITE_URL=
